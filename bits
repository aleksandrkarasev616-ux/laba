// Переинтерпретация битов через memcpy (без UB, в отличие от чтения неактивного поля union)
template <class To, class From>
To reinterpretBits(const From& from) {
    static_assert(sizeof(To) == sizeof(From), "размеры типов должны совпадать");
    To to;
    std::memcpy(&to, &from, sizeof(To));
    return to;
}

// Одна функция для всех разрядностей: &= ~mask, |= mask, ^= mask
template <class U>
U applyOp(U value, int pos, BitOp op) {
    const int width = static_cast<int>(sizeof(U) * 8);
    if (pos < 0 || pos >= width)
        throw std::out_of_range("номер бита должен быть в диапазоне 0.." + std::to_string(width - 1));

    const U mask = static_cast<U>(U(1) << pos);
    switch (op) {
        case BitOp::Clear:  return static_cast<U>(value & ~mask);
        case BitOp::Set:    return static_cast<U>(value | mask);
        case BitOp::Toggle: return static_cast<U>(value ^ mask);
    }
    throw std::invalid_argument("неизвестная операция");
}

std::string kindName(int c) {
    switch (c) {
        case FP_ZERO:      return "ноль";
        case FP_SUBNORMAL: return "денормализованное";
        case FP_NORMAL:    return "нормализованное";
        case FP_INFINITE:  return "бесконечность";
        default:           return "NaN";
    }
}

